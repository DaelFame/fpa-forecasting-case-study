      "general": [
        {
          "properties": {
            "paragraphs": [
              {
                "textRuns": [
                  {
                    "value": "The plan was beaten by 867,945, or 21.9%, across the four years it covers.",
                    "textStyle": {
                      "fontWeight": "bold",
                      "fontSize": "14pt",
                      "color": "#1f3864"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Unit cost (551,368) and volume (255,229) carried the beat, and an extraordinary result added 572,000.",
                    "textStyle": {
                      "fontWeight": "bold",
                      "fontSize": "14pt",
                      "color": "#1f3864"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Price (-235,793) and operating expenses (-326,210) gave part of it back, led by General (-199,051) and R&D (-155,100).",
                    "textStyle": {
                      "fontWeight": "bold",
                      "fontSize": "14pt",
                      "color": "#1f3864"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "The miss is early, not systemic: 2026 fell 243,137 short, and every year after it beat plan.",
                    "textStyle": {
                      "fontWeight": "bold",
                      "fontSize": "14pt",
                      "color": "#1f3864"
                    }
                  }
                ]
              }
            ]
          }
        }
      ]
