            "paragraphs": [
              {
                "textRuns": [
                  {
                    "value": "The model gets direction right and level wrong: both folds under-called profit, by 0.61M and then 1.06M.",
                    "textStyle": {
                      "fontWeight": "bold",
                      "fontSize": "14pt",
                      "color": "#1f3864"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "The bias widened from -8.8% on the 2028 fold to -21.4% on the 2029 one.",
                    "textStyle": {
                      "fontWeight": "bold",
                      "fontSize": "14pt",
                      "color": "#1f3864"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "That bias is pessimism, not volume: revenue was called 1.12M too low and gross profit 1.22M too low.",
                    "textStyle": {
                      "fontWeight": "bold",
                      "fontSize": "14pt",
                      "color": "#1f3864"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "2030 repeats 2029 in the base case at 6,206,656 of revenue and 2,385,094 of profit; the scenarios run from 1.61M to 2.71M.",
                    "textStyle": {
                      "fontWeight": "bold",
                      "fontSize": "14pt",
                      "color": "#1f3864"
                    }
                  }
                ]
              }
            ]
          }
        }
