    "objects": {
      "general": [
        {
          "properties": {
            "paragraphs": [
              {
                "textRuns": [
                  {
                    "value": "Demand is not the problem: 2.33M, 2.35M and 2.43M units were up for grabs in 2026, 2027 and 2028.",
                    "textStyle": {
                      "fontWeight": "bold",
                      "fontSize": "14pt",
                      "color": "#1f3864"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Supply is: 600,479, 662,341 and 594,748 units of that demand went unserved - 24.5% of it in 2028.",
                    "textStyle": {
                      "fontWeight": "bold",
                      "fontSize": "14pt",
                      "color": "#1f3864"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Price is not the blocker either: company units rose from 271,592 to 410,046 and share from 14.3% to 20.1%.",
                    "textStyle": {
                      "fontWeight": "bold",
                      "fontSize": "14pt",
                      "color": "#1f3864"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "The gap is concentrated in neckties, 1.37M of the 1.86M unserved units, so capacity there is the constraint.",
                    "textStyle": {
                      "fontWeight": "bold",
                      "fontSize": "14pt",
                      "color": "#1f3864"
                    }
                  }
                ]
              }
            ]
          }
        }
      ]
    },
