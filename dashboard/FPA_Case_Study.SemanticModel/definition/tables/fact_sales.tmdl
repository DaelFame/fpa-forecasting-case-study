table fact_sales

	column period_key
		dataType: string
		isHidden
		summarizeBy: none
		sourceColumn: period_key

	column product_key
		dataType: string
		isHidden
		summarizeBy: none
		sourceColumn: product_key

	column units_sold
		dataType: int64
		summarizeBy: none
		sourceColumn: units_sold

	column revenue
		dataType: int64
		summarizeBy: none
		sourceColumn: revenue

	partition fact_sales = m
		mode: import
		source =
			let
				Origen = Csv.Document(File.Contents(pDataFolder & "\fact_sales.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				Encabezados = Table.PromoteHeaders(Origen, [PromoteAllScalars=true]),
				Tipos = Table.TransformColumnTypes(Encabezados, {{"period_key", type text}, {"product_key", type text}, {"units_sold", Int64.Type}, {"revenue", Int64.Type}})
			in
				Tipos
