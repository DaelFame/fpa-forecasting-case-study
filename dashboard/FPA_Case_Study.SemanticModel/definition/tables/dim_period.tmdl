table dim_period

	column period_key
		dataType: string
		isHidden
		summarizeBy: none
		sourceColumn: period_key

	column grain
		dataType: string
		summarizeBy: none
		sourceColumn: grain

	column year
		dataType: int64
		summarizeBy: none
		sourceColumn: year

	column quarter
		dataType: int64
		summarizeBy: none
		sourceColumn: quarter

	column period_end
		dataType: dateTime
		summarizeBy: none
		sourceColumn: period_end

	column label
		dataType: string
		summarizeBy: none
		sourceColumn: label

	column is_closed
		dataType: boolean
		summarizeBy: none
		sourceColumn: is_closed

	column is_forecast
		dataType: boolean
		summarizeBy: none
		sourceColumn: is_forecast

	partition dim_period = m
		mode: import
		source =
			let
				Origen = Csv.Document(File.Contents(pDataFolder & "\dim_period.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				Encabezados = Table.PromoteHeaders(Origen, [PromoteAllScalars=true]),
				Reemplazados = Table.ReplaceValue(Encabezados, "", null, Replacer.ReplaceValue, {"quarter"}),
				Tipos = Table.TransformColumnTypes(Reemplazados, {{"period_key", type text}, {"grain", type text}, {"year", Int64.Type}, {"quarter", Int64.Type}, {"period_end", type date}, {"label", type text}, {"is_closed", type logical}, {"is_forecast", type logical}})
			in
				Tipos
