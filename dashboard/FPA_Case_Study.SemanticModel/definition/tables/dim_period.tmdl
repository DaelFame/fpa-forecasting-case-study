	partition dim_period = m
		mode: import
		source =
				let
					Origen = Csv.Document(File.Contents(pDataFolder & "\dim_period.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
					Encabezados = Table.PromoteHeaders(Origen, [PromoteAllScalars=true]),
					Reemplazados = Table.ReplaceValue(Encabezados, "", null, Replacer.ReplaceValue, {"quarter"}),
					Tipos = Table.TransformColumnTypes(Reemplazados, {{"period_key", type text}, {"grain", type text}, {"year", Int64.Type}, {"quarter", Int64.Type}, {"period_end", type date}, {"label", type text}, {"is_closed", type logical}, {"is_forecast", type logical}})
				in
					Tipos

