table fact_product_annual
	lineageTag: 32e89a83-3b4e-40bb-9d0f-e68b956f0e04

	column period_key
		dataType: string
		isHidden
		lineageTag: 39265ae0-9ebd-49f7-bf18-4301d3151efb
		summarizeBy: none
		sourceColumn: period_key

	column product_key
		dataType: string
		isHidden
		lineageTag: 8d108d5c-8da8-4fa9-b9f1-dcd4a30c4691
		summarizeBy: none
		sourceColumn: product_key

	column revenue
		dataType: int64
		lineageTag: 36cf0511-0a05-4665-8ba0-6464126fc26e
		summarizeBy: none
		sourceColumn: revenue

	column cost_of_sales
		dataType: int64
		lineageTag: 4500b7c8-15ce-404f-acfe-9680f03a9977
		summarizeBy: none
		sourceColumn: cost_of_sales

	column gross_margin
		dataType: int64
		lineageTag: 57f5502a-5621-4bec-ae2b-7b90483544c1
		summarizeBy: none
		sourceColumn: gross_margin

	partition fact_product_annual = m
		mode: import
		source =
				let
					Origen = Csv.Document(File.Contents(pDataFolder & "\fact_product_annual.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
					Encabezados = Table.PromoteHeaders(Origen, [PromoteAllScalars=true]),
					Tipos = Table.TransformColumnTypes(Encabezados, {{"period_key", type text}, {"product_key", type text}, {"revenue", Int64.Type}, {"cost_of_sales", Int64.Type}, {"gross_margin", Int64.Type}})
				in
					Tipos

