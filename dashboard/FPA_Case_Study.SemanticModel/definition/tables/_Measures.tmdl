table _Measures
	lineageTag: 35725c68-c7ea-47b6-8d37-3e52559c9126

	/// Revenue recognised in the selected period, always from the actual scenario.
	measure Revenue =
			CALCULATE(
			    SUM(fact_financials[amount]),
			    dim_scenario[scenario_key] = "actual",
			    dim_line_item[line_item_key] = "revenue_total"
			)
		formatString: #,##0
		displayFolder: 01 Executive
		lineageTag: e4e45f30-138e-4c50-a61f-a59874bab146

	/// Revenue less cost of sales.
	measure 'Gross Margin' =
			CALCULATE(
			    SUM(fact_financials[amount]),
			    dim_scenario[scenario_key] = "actual",
			    dim_line_item[line_item_key] = "gross_profit"
			)
		formatString: #,##0
		displayFolder: 01 Executive
		lineageTag: 9b885a68-81c2-405c-9447-6d84851139f4

	measure 'Gross Margin %' = DIVIDE([Gross Margin], [Revenue])
		formatString: 0.0%
		displayFolder: 01 Executive
		lineageTag: 023ceff7-7307-4dbb-829b-76c25efad1f1

	/// Result before tax. The budget carries no tax line, so every variance is measured pre-tax.
	measure 'Net Income' =
			CALCULATE(
			    SUM(fact_financials[amount]),
			    dim_scenario[scenario_key] = "actual",
			    dim_line_item[line_item_key] = "net_result_before_taxes"
			)
		formatString: #,##0
		displayFolder: 01 Executive
		lineageTag: 595aabe9-94bd-4042-b25c-2469f8eefb79

	measure 'Net Margin %' = DIVIDE([Net Income], [Revenue])
		formatString: 0.0%
		displayFolder: 01 Executive
		lineageTag: 4a41ac0a-7022-410d-b8cd-8d214b9e735c

	/// Latest year with a reported close. Use it in titles instead of hardcoding a year.
	measure 'Latest Closed Year' =
			CALCULATE(
			    MAX(dim_period[year]),
			    dim_period[grain] = "year",
			    dim_period[is_closed] = TRUE()
			)
		formatString: 0
		displayFolder: 01 Executive
		lineageTag: 6e851c29-a8ca-42b4-99ac-1b3060fba069

	/// Cash at the end of the period. Balances are semi-additive: never sum across time.
	measure 'Closing Cash' =
			CALCULATE(
			    SUM(fact_balance[amount]),
			    dim_account[account_key] = "cash",
			    LASTNONBLANK(dim_period[year], 1)
			)
		formatString: #,##0
		displayFolder: 01 Executive
		lineageTag: 22d691b2-027f-4089-9243-686480a8b5b2

	/// Total assets at the end of the period. Semi-additive, like every balance.
	measure 'Total Assets' =
			CALCULATE(
			    SUM(fact_balance[amount]),
			    dim_account[account_key] = "total_assets",
			    LASTNONBLANK(dim_period[year], 1)
			)
		formatString: #,##0
		displayFolder: 01 Executive
		lineageTag: d67032f3-6a87-4560-9b15-4b17a4aa0625

	measure 'Product Revenue' = SUM(fact_product_annual[revenue])
		formatString: #,##0
		displayFolder: 02 Profitability
		lineageTag: e64ce3bf-2fb0-4dbe-b532-66004eef9f66

	measure 'Product Gross Margin' = SUM(fact_product_annual[gross_margin])
		formatString: #,##0
		displayFolder: 02 Profitability
		lineageTag: f3daeed4-7797-475f-be2e-7abe8f71169e

	measure 'Product Margin %' = DIVIDE([Product Gross Margin], [Product Revenue])
		formatString: 0.0%
		displayFolder: 02 Profitability
		lineageTag: 0775629d-5ade-4e8f-8819-779eab6daf8a

	measure 'Units Sold' = SUM(fact_sales[units_sold])
		formatString: #,##0
		displayFolder: 02 Profitability
		lineageTag: c308959f-e3d1-4105-9885-e2210fe3c14f

	measure 'Quarterly Revenue' = SUM(fact_sales[revenue])
		formatString: #,##0
		displayFolder: 02 Profitability
		lineageTag: 865ce766-147e-4935-8cc3-bcc3fbbc7a24

	/// Plan committed for the period. Pre-tax, because the budget models no tax.
	measure 'Budget Net Income' =
			CALCULATE(
			    SUM(fact_financials[amount]),
			    dim_scenario[scenario_key] = "budget",
			    dim_line_item[line_item_key] = "net_result_before_taxes"
			)
		formatString: #,##0
		displayFolder: 03 Variance
		lineageTag: 134e1be6-0763-43c8-9b04-021d243f2724

	measure 'Net Income vs Budget' = [Net Income] - [Budget Net Income]
		formatString: #,##0
		displayFolder: 03 Variance
		lineageTag: fc92d957-cd01-494f-8024-7a85b965cc07

	measure 'Net Income vs Budget %' = DIVIDE([Net Income vs Budget], [Budget Net Income])
		formatString: 0.0%
		displayFolder: 03 Variance
		lineageTag: 35497d69-af28-4ec9-90bd-90f169212732

	/// Sum of the bridge drivers. Must equal [Net Income vs Budget] to the euro.
	measure 'Bridge Total' = SUM(fact_variance[amount])
		formatString: #,##0
		displayFolder: 03 Variance
		lineageTag: 4ed4705b-484f-4665-99c3-ba7982157928

	measure 'Bridge Residual' = [Bridge Total] - [Net Income vs Budget]
		formatString: #,##0
		displayFolder: 03 Variance
		lineageTag: ea943644-ba90-4456-a67b-af155ea539f7

	measure 'Forecast Amount' = SUM(fact_forecast[forecast_amount])
		formatString: #,##0
		displayFolder: 04 Forecast
		lineageTag: 025a7ecc-a04c-44d1-ad9f-e28ae46c36b5

	measure 'Forecast Error' = SUM(fact_backtest[error_eur])
		formatString: #,##0
		displayFolder: 04 Forecast
		lineageTag: 5cb1c6e0-54e3-419e-8235-46f276ebf0e3

	/// Weighted error: ratio of sums, never an average of per-line percentages.
	measure 'MAPE Weighted' =
			DIVIDE(
			    SUMX(fact_backtest, ABS(fact_backtest[error_eur])),
			    SUMX(fact_backtest, ABS(fact_backtest[actual_amount]))
			)
		formatString: 0.0%
		displayFolder: 04 Forecast
		lineageTag: 29ea30eb-5da5-43cd-8931-a0946782c135

	/// Positive means the forecast landed above the actual outcome.
	measure 'Bias Weighted' =
			DIVIDE(
			    SUM(fact_backtest[error_eur]),
			    SUMX(fact_backtest, ABS(fact_backtest[actual_amount]))
			)
		formatString: +0.0%;-0.0%;0.0%
		displayFolder: 04 Forecast
		lineageTag: bab8f9d9-c022-406d-a41f-53557862ebf7

	measure 'Forecast Accuracy %' = 1 - [MAPE Weighted]
		formatString: 0.0%
		displayFolder: 04 Forecast
		lineageTag: d06261fd-e5f2-4f93-90fd-60cf4f47f2d6

	measure 'Market Units' = SUM(fact_market[market_units])
		formatString: #,##0
		displayFolder: 05 Market
		lineageTag: 25aeea19-52e4-4aba-933a-8e9c5abd8714

	measure 'Market Units Sold' = SUM(fact_market[units_sold])
		formatString: #,##0
		displayFolder: 05 Market
		lineageTag: 7281ec8d-8e24-4e23-bfa6-08ea938093a1

	measure 'Market Share %' = DIVIDE([Market Units Sold], [Market Units])
		formatString: 0.0%
		displayFolder: 05 Market
		lineageTag: 9292eba7-70ca-419a-abd6-82d189a50a62

	measure 'Unserved Units' = SUM(fact_market[unserved_units])
		formatString: #,##0
		displayFolder: 05 Market
		lineageTag: bb2c3477-4cb4-4b47-b4d6-6be4afe512b3

	/// Bounded to the latest closed year so a KPI card never sums every period.
	measure 'Revenue Latest' =
			VAR LastYear = [Latest Closed Year]
			RETURN
			    CALCULATE ( [Revenue], dim_period[grain] = "year", dim_period[year] = LastYear )
		formatString: #,##0
		displayFolder: 01 Executive
		lineageTag: f70608a5-1393-45f8-9201-ca781566bb40

	/// Bounded to the latest closed year so a KPI card never sums every period.
	measure 'Gross Margin % Latest' =
			VAR LastYear = [Latest Closed Year]
			RETURN
			    CALCULATE ( [Gross Margin %], dim_period[grain] = "year", dim_period[year] = LastYear )
		formatString: 0.0%
		displayFolder: 01 Executive
		lineageTag: a7aaf2cf-7fe3-490d-9644-135445e542f8

	/// Bounded to the latest closed year so a KPI card never sums every period.
	measure 'Net Income Latest' =
			VAR LastYear = [Latest Closed Year]
			RETURN
			    CALCULATE ( [Net Income], dim_period[grain] = "year", dim_period[year] = LastYear )
		formatString: #,##0
		displayFolder: 01 Executive
		lineageTag: cff2d7b1-4cdd-412d-93a6-6cc50b932c47

	/// Bounded to the latest closed year so a KPI card never sums every period.
	measure 'Net Income vs Budget % Latest' =
			VAR LastYear = [Latest Closed Year]
			RETURN
			    CALCULATE ( [Net Income vs Budget %], dim_period[grain] = "year", dim_period[year] = LastYear )
		formatString: +0.0%;-0.0%;0.0%
		displayFolder: 01 Executive
		lineageTag: 542e855a-da0f-41c1-bc92-505ff5617adf

	/// Bounded to the latest closed year so a KPI card never sums every period.
	measure 'Closing Cash Latest' =
			VAR LastYear = [Latest Closed Year]
			RETURN
			    CALCULATE ( [Closing Cash], dim_period[grain] = "year", dim_period[year] = LastYear )
		formatString: #,##0
		displayFolder: 01 Executive
		lineageTag: b6cc8201-cfaa-44d8-93cd-af09f2474d47

	/// Revenue as text for KPI cards. The card visual compacts numbers to millions
	/// and its display-units switch is not reachable in this version, so the value
	/// is formatted here instead.
	measure 'Revenue Card' = FORMAT([Revenue Latest], "#,##0")
		displayFolder: 01 Executive
		lineageTag: 1117b26e-1124-4e60-a343-ad97fd53cb33

	/// Net income as text for KPI cards. Same reason as [Revenue Card].
	measure 'Net Income Card' = FORMAT([Net Income Latest], "#,##0")
		displayFolder: 01 Executive
		lineageTag: d9c305c8-5eec-4146-860c-85240389562f

	/// Closing cash as text for KPI cards. Same reason as [Revenue Card].
	measure 'Closing Cash Card' = FORMAT([Closing Cash Latest], "#,##0")
		displayFolder: 01 Executive
		lineageTag: 9c0211e7-d897-4c68-9571-818c62669b32

	/// Revenue of the year before the latest close. Comparison base for the KPI cards.
	measure 'Revenue Prev' = ```
			VAR LastYear = [Latest Closed Year]
			RETURN
			    CALCULATE ( [Revenue], dim_period[grain] = "year", dim_period[year] = LastYear - 1 )
			```
		formatString: #,##0
		displayFolder: 90 Comparison

	measure 'Gross Margin % Prev' = ```
			VAR LastYear = [Latest Closed Year]
			RETURN
			    CALCULATE ( [Gross Margin %], dim_period[grain] = "year", dim_period[year] = LastYear - 1 )
			```
		formatString: 0.0%
		displayFolder: 90 Comparison

	measure 'Net Income Prev' = ```
			VAR LastYear = [Latest Closed Year]
			RETURN
			    CALCULATE ( [Net Income], dim_period[grain] = "year", dim_period[year] = LastYear - 1 )
			```
		formatString: #,##0
		displayFolder: 90 Comparison

	measure 'Closing Cash Prev' = ```
			VAR LastYear = [Latest Closed Year]
			RETURN
			    CALCULATE ( [Closing Cash], dim_period[grain] = "year", dim_period[year] = LastYear - 1 )
			```
		formatString: #,##0
		displayFolder: 90 Comparison

	/// Year-on-year change, for the reference label under a KPI card.
	measure 'Revenue YoY %' =
			DIVIDE ( [Revenue Latest] - [Revenue Prev], [Revenue Prev] )
		formatString: +0.0%;-0.0%;0.0%
		displayFolder: 01 Executive

	/// Change in percentage points, not a relative change: 5.6 pp, not 9.8%.
	measure 'Gross Margin pts YoY' =
			( [Gross Margin % Latest] - [Gross Margin % Prev] ) * 100
		formatString: +0.0" pp";-0.0" pp";0.0" pp"
		displayFolder: 01 Executive

	/// Absolute change in euros. A percentage is meaningless when the base is negative.
	measure 'Net Income YoY' =
			[Net Income Latest] - [Net Income Prev]
		formatString: +#,##0;-#,##0;0
		displayFolder: 01 Executive

	measure 'Closing Cash YoY %' =
			DIVIDE ( [Closing Cash Latest] - [Closing Cash Prev], [Closing Cash Prev] )
		formatString: +0.0%;-0.0%;0.0%
		displayFolder: 01 Executive

	/// Text version for the card reference label, which compacts numbers to millions.
	measure 'Net Income YoY Label' = FORMAT ( [Net Income YoY], "+#,##0;-#,##0;0" )
		displayFolder: 01 Executive

	column Dummy
		dataType: string
		isHidden
		lineageTag: aa3dcf9f-3b66-4bfb-87f0-4b80acd49c0c
		summarizeBy: none
		sourceColumn: [Dummy]

	partition _Measures = calculated
		mode: import
		source = ROW("Dummy", BLANK())

