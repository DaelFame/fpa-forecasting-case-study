table _Measures
	lineageTag: 35725c68-c7ea-47b6-8d37-3e52559c9126

	/// Revenue recognised in the selected period, always from the actual scenario.
	measure Revenue =
			CALCULATE(
			    SUM(fact_financials[amount]),
			    dim_scenario[scenario_key] = "actual",
			    dim_line_item[line_item_key] = "revenue_total"
			)
		formatString: #,##0
		displayFolder: 01 Executive
		lineageTag: e4e45f30-138e-4c50-a61f-a59874bab146

	/// Revenue less cost of sales.
	measure 'Gross Margin' =
			CALCULATE(
			    SUM(fact_financials[amount]),
			    dim_scenario[scenario_key] = "actual",
			    dim_line_item[line_item_key] = "gross_profit"
			)
		formatString: #,##0
		displayFolder: 01 Executive
		lineageTag: 9b885a68-81c2-405c-9447-6d84851139f4

	measure 'Gross Margin %' = DIVIDE([Gross Margin], [Revenue])
		formatString: 0.0%
		displayFolder: 01 Executive
		lineageTag: 023ceff7-7307-4dbb-829b-76c25efad1f1

	/// Result before tax. The budget carries no tax line, so every variance is measured pre-tax.
	measure 'Net Income' =
			CALCULATE(
			    SUM(fact_financials[amount]),
			    dim_scenario[scenario_key] = "actual",
			    dim_line_item[line_item_key] = "net_result_before_taxes"
			)
		formatString: #,##0
		displayFolder: 01 Executive
		lineageTag: 595aabe9-94bd-4042-b25c-2469f8eefb79

	measure 'Net Margin %' = DIVIDE([Net Income], [Revenue])
		formatString: 0.0%
		displayFolder: 01 Executive
		lineageTag: 4a41ac0a-7022-410d-b8cd-8d214b9e735c

	/// Latest year with a reported close. Use it in titles instead of hardcoding a year.
	measure 'Latest Closed Year' =
			CALCULATE(
			    MAX(dim_period[year]),
			    dim_period[grain] = "year",
			    dim_period[is_closed] = TRUE()
			)
		formatString: 0
		displayFolder: 01 Executive
		lineageTag: 6e851c29-a8ca-42b4-99ac-1b3060fba069

	/// Cash at the end of the period. Balances are semi-additive: never sum across time.
	measure 'Closing Cash' =
			CALCULATE(
			    SUM(fact_balance[amount]),
			    dim_account[account_key] = "cash",
			    LASTNONBLANK(dim_period[year], 1)
			)
		formatString: #,##0
		displayFolder: 01 Executive
		lineageTag: 22d691b2-027f-4089-9243-686480a8b5b2

	/// Total assets at the end of the period. Semi-additive, like every balance.
	measure 'Total Assets' =
			CALCULATE(
			    SUM(fact_balance[amount]),
			    dim_account[account_key] = "total_assets",
			    LASTNONBLANK(dim_period[year], 1)
			)
		formatString: #,##0
		displayFolder: 01 Executive
		lineageTag: d67032f3-6a87-4560-9b15-4b17a4aa0625

	measure 'Product Revenue' = SUM(fact_product_annual[revenue])
		formatString: #,##0
		displayFolder: 02 Profitability
		lineageTag: e64ce3bf-2fb0-4dbe-b532-66004eef9f66

	measure 'Product Gross Margin' = SUM(fact_product_annual[gross_margin])
		formatString: #,##0
		displayFolder: 02 Profitability
		lineageTag: f3daeed4-7797-475f-be2e-7abe8f71169e

	measure 'Product Margin %' = DIVIDE([Product Gross Margin], [Product Revenue])
		formatString: 0.0%
		displayFolder: 02 Profitability
		lineageTag: 0775629d-5ade-4e8f-8819-779eab6daf8a

	measure 'Units Sold' = SUM(fact_sales[units_sold])
		formatString: #,##0
		displayFolder: 02 Profitability
		lineageTag: c308959f-e3d1-4105-9885-e2210fe3c14f

	measure 'Quarterly Revenue' = SUM(fact_sales[revenue])
		formatString: #,##0
		displayFolder: 02 Profitability
		lineageTag: 865ce766-147e-4935-8cc3-bcc3fbbc7a24

	/// Plan committed for the period. Pre-tax, because the budget models no tax.
	measure 'Budget Net Income' =
			CALCULATE(
			    SUM(fact_financials[amount]),
			    dim_scenario[scenario_key] = "budget",
			    dim_line_item[line_item_key] = "net_result_before_taxes"
			)
		formatString: #,##0
		displayFolder: 03 Variance
		lineageTag: 134e1be6-0763-43c8-9b04-021d243f2724

	/// Variance is only defined for years the plan covers. Budget starts in 2026,
	/// so years without a plan are skipped instead of being counted as full misses.
	measure 'Net Income vs Budget' =
			SUMX (
			    VALUES ( dim_period[year] ),
			    VAR BudgetAmount = CALCULATE ( [Budget Net Income] )
			    RETURN
			        IF ( NOT ISBLANK ( BudgetAmount ), CALCULATE ( [Net Income] ) - BudgetAmount )
			)
		formatString: +#,##0;-#,##0;0
		displayFolder: 03 Variance
		lineageTag: fc92d957-cd01-494f-8024-7a85b965cc07

	measure 'Net Income vs Budget %' = DIVIDE([Net Income vs Budget], [Budget Net Income])
		formatString: 0.0%
		displayFolder: 03 Variance
		lineageTag: 35497d69-af28-4ec9-90bd-90f169212732

	/// Sum of the bridge drivers. Must equal [Net Income vs Budget] to the euro.
	measure 'Bridge Total' = SUM(fact_variance[amount])
		formatString: #,##0
		displayFolder: 03 Variance
		lineageTag: 4ed4705b-484f-4665-99c3-ba7982157928

	measure 'Bridge Residual' = [Bridge Total] - [Net Income vs Budget]
		formatString: #,##0
		displayFolder: 03 Variance
		lineageTag: ea943644-ba90-4456-a67b-af155ea539f7

	/// fact_forecast stores each line item once per regime, and both regimes carry
	/// the same value, so an unfiltered sum would multiply every 2030 figure. One
	/// regime is kept; the scenario dimension still splits base, upside, downside
	/// and stress.
	measure 'Forecast Amount' = CALCULATE ( SUM ( fact_forecast[forecast_amount] ), dim_regime[regime_key] = "A" )
		formatString: #,##0
		displayFolder: 04 Forecast
		lineageTag: 025a7ecc-a04c-44d1-ad9f-e28ae46c36b5

	measure 'Forecast Error' = SUM(fact_backtest[error_eur])
		formatString: #,##0
		displayFolder: 04 Forecast
		lineageTag: 5cb1c6e0-54e3-419e-8235-46f276ebf0e3

	/// Weighted error: ratio of sums, never an average of per-line percentages.
	/// Restricted to the committed regime, the same one the 2030 forecast uses;
	/// blending both regimes would describe no single model.
	measure 'MAPE Weighted' =
			CALCULATE (
			    DIVIDE(
			        SUMX(fact_backtest, ABS(fact_backtest[error_eur])),
			        SUMX(fact_backtest, ABS(fact_backtest[actual_amount]))
			    ),
			    fact_backtest[regime_key] = "A"
			)
		formatString: 0.0%
		displayFolder: 04 Forecast
		lineageTag: 29ea30eb-5da5-43cd-8931-a0946782c135

	/// Positive means the forecast landed above the actual outcome. Same regime
	/// restriction as [MAPE Weighted].
	measure 'Bias Weighted' =
			CALCULATE (
			    DIVIDE(
			        SUM(fact_backtest[error_eur]),
			        SUMX(fact_backtest, ABS(fact_backtest[actual_amount]))
			    ),
			    fact_backtest[regime_key] = "A"
			)
		formatString: +0.0%;-0.0%;0.0%
		displayFolder: 04 Forecast
		lineageTag: bab8f9d9-c022-406d-a41f-53557862ebf7

	measure 'Forecast Accuracy %' = 1 - [MAPE Weighted]
		formatString: 0.0%
		displayFolder: 04 Forecast
		lineageTag: d06261fd-e5f2-4f93-90fd-60cf4f47f2d6

	measure 'Market Units' = SUM(fact_market[market_units])
		formatString: #,##0
		displayFolder: 05 Market
		lineageTag: 25aeea19-52e4-4aba-933a-8e9c5abd8714

	measure 'Market Units Sold' = SUM(fact_market[units_sold])
		formatString: #,##0
		displayFolder: 05 Market
		lineageTag: 7281ec8d-8e24-4e23-bfa6-08ea938093a1

	measure 'Market Share %' = DIVIDE([Market Units Sold], [Market Units])
		formatString: 0.0%
		displayFolder: 05 Market
		lineageTag: 9292eba7-70ca-419a-abd6-82d189a50a62

	measure 'Unserved Units' = SUM(fact_market[unserved_units])
		formatString: #,##0
		displayFolder: 05 Market
		lineageTag: bb2c3477-4cb4-4b47-b4d6-6be4afe512b3

	/// Bounded to the latest closed year so a KPI card never sums every period.
	measure 'Revenue Latest' =
			VAR LastYear = [Latest Closed Year]
			RETURN
			    CALCULATE ( [Revenue], dim_period[grain] = "year", dim_period[year] = LastYear )
		formatString: #,##0
		displayFolder: 01 Executive
		lineageTag: f70608a5-1393-45f8-9201-ca781566bb40

	/// Bounded to the latest closed year so a KPI card never sums every period.
	measure 'Gross Margin % Latest' =
			VAR LastYear = [Latest Closed Year]
			RETURN
			    CALCULATE ( [Gross Margin %], dim_period[grain] = "year", dim_period[year] = LastYear )
		formatString: 0.0%
		displayFolder: 01 Executive
		lineageTag: a7aaf2cf-7fe3-490d-9644-135445e542f8

	/// Bounded to the latest closed year so a KPI card never sums every period.
	measure 'Net Income Latest' =
			VAR LastYear = [Latest Closed Year]
			RETURN
			    CALCULATE ( [Net Income], dim_period[grain] = "year", dim_period[year] = LastYear )
		formatString: #,##0
		displayFolder: 01 Executive
		lineageTag: cff2d7b1-4cdd-412d-93a6-6cc50b932c47

	/// Bounded to the latest closed year so a KPI card never sums every period.
	measure 'Net Income vs Budget % Latest' =
			VAR LastYear = [Latest Closed Year]
			RETURN
			    CALCULATE ( [Net Income vs Budget %], dim_period[grain] = "year", dim_period[year] = LastYear )
		formatString: +0.0%;-0.0%;0.0%
		displayFolder: 01 Executive
		lineageTag: 542e855a-da0f-41c1-bc92-505ff5617adf

	/// Bounded to the latest closed year so a KPI card never sums every period.
	measure 'Closing Cash Latest' =
			VAR LastYear = [Latest Closed Year]
			RETURN
			    CALCULATE ( [Closing Cash], dim_period[grain] = "year", dim_period[year] = LastYear )
		formatString: #,##0
		displayFolder: 01 Executive
		lineageTag: b6cc8201-cfaa-44d8-93cd-af09f2474d47

	/// Revenue as text for KPI cards. The card visual compacts numbers to millions
	/// and its display-units switch is not reachable in this version, so the value
	/// is formatted here instead.
	measure 'Revenue Card' = FORMAT([Revenue Latest], "#,##0")
		displayFolder: 01 Executive
		lineageTag: 1117b26e-1124-4e60-a343-ad97fd53cb33

	/// Net income as text for KPI cards. Same reason as [Revenue Card].
	measure 'Net Income Card' = FORMAT([Net Income Latest], "#,##0")
		displayFolder: 01 Executive
		lineageTag: d9c305c8-5eec-4146-860c-85240389562f

	/// Closing cash as text for KPI cards. Same reason as [Revenue Card].
	measure 'Closing Cash Card' = FORMAT([Closing Cash Latest], "#,##0")
		displayFolder: 01 Executive
		lineageTag: 9c0211e7-d897-4c68-9571-818c62669b32

	/// Revenue of the year before the latest close. Comparison base for the KPI cards.
	measure 'Revenue Prev' =
			VAR LastYear = [Latest Closed Year]
			RETURN
			    CALCULATE ( [Revenue], dim_period[grain] = "year", dim_period[year] = LastYear - 1 )
		formatString: #,##0
		displayFolder: 90 Comparison
		lineageTag: 5f96fa7b-ee50-4a69-a701-43575ef787bf

	measure 'Gross Margin % Prev' =
			VAR LastYear = [Latest Closed Year]
			RETURN
			    CALCULATE ( [Gross Margin %], dim_period[grain] = "year", dim_period[year] = LastYear - 1 )
		formatString: 0.0%
		displayFolder: 90 Comparison
		lineageTag: 8a04ab9b-a32e-4c24-ae5b-ee9cb11c03cd

	measure 'Net Income Prev' =
			VAR LastYear = [Latest Closed Year]
			RETURN
			    CALCULATE ( [Net Income], dim_period[grain] = "year", dim_period[year] = LastYear - 1 )
		formatString: #,##0
		displayFolder: 90 Comparison
		lineageTag: e3759119-4ba4-43c0-9b77-8c8e0992e966

	measure 'Closing Cash Prev' =
			VAR LastYear = [Latest Closed Year]
			RETURN
			    CALCULATE ( [Closing Cash], dim_period[grain] = "year", dim_period[year] = LastYear - 1 )
		formatString: #,##0
		displayFolder: 90 Comparison
		lineageTag: 122ddd3e-0dfb-4eff-b1c9-21827132f792

	/// Year-on-year change, for the reference label under a KPI card.
	measure 'Revenue YoY %' = DIVIDE ( [Revenue Latest] - [Revenue Prev], [Revenue Prev] )
		formatString: +0.0%;-0.0%;0.0%
		displayFolder: 01 Executive
		lineageTag: 9dc4fd5c-9a73-4357-9fb6-c41d814c32f7

	/// Change in percentage points, not a relative change: 5.6 pp, not 9.8%.
	measure 'Gross Margin pts YoY' = ( [Gross Margin % Latest] - [Gross Margin % Prev] ) * 100
		formatString: +0.0" pp";-0.0" pp";0.0" pp"
		displayFolder: 01 Executive
		lineageTag: c8a0d29d-1825-4616-b937-8ad5c3eddfa5

	/// Absolute change in euros. A percentage is meaningless when the base is negative.
	measure 'Net Income YoY' = [Net Income Latest] - [Net Income Prev]
		formatString: +#,##0;-#,##0;0
		displayFolder: 01 Executive
		lineageTag: 2d31aaa0-014d-455b-8d6e-a07605cccfb5

	measure 'Closing Cash YoY %' = DIVIDE ( [Closing Cash Latest] - [Closing Cash Prev], [Closing Cash Prev] )
		formatString: +0.0%;-0.0%;0.0%
		displayFolder: 01 Executive
		lineageTag: b6a364fc-c7ff-4f35-b02c-e2b6d8bcd0b4

	/// Text version for the card reference label, which compacts numbers to millions.
	measure 'Net Income YoY Label' = FORMAT ( [Net Income YoY], "+#,##0;-#,##0;0" )
		displayFolder: 01 Executive
		lineageTag: b40def4c-50f7-45c0-9567-0729a0a46c8c

	/// The euro amount behind the budget variance percentage.
	measure 'Net Income vs Budget Latest' =
			VAR LastYear = [Latest Closed Year]
			RETURN
			    CALCULATE ( [Net Income vs Budget], dim_period[grain] = "year", dim_period[year] = LastYear )
		formatString: +#,##0;-#,##0;0
		displayFolder: 01 Executive
		lineageTag: dac4a93c-4f5a-44f4-b29f-7397c95e331e

	measure 'Net Income vs Budget Label' = FORMAT ( [Net Income vs Budget Latest], "+#,##0;-#,##0;0" )
		displayFolder: 01 Executive
		lineageTag: b4e3ea1d-5b08-4514-9e34-6e69ade14f5f

	/// Budget variance carried by operating expenses, with the cost-overrun sign.
	measure 'Operating Expenses Variance' = CALCULATE ( [Bridge Total], dim_driver[label] = "Operating expenses" )
		formatString: +#,##0;-#,##0;0
		displayFolder: 03 Variance
		lineageTag: fae19c2d-5894-450f-8df2-1bd6694807ef

	/// Budget years where actual net income beat the plan. Years without a plan
	/// return blank variance and are never counted as a win.
	measure 'Years Ahead of Plan' =
			COUNTROWS (
			    FILTER ( VALUES ( dim_period[year] ), CALCULATE ( [Net Income vs Budget] ) > 0 )
			)
		formatString: 0
		displayFolder: 03 Variance
		lineageTag: 93ce70d5-b46d-47b4-b4b6-88d580129550

	measure 'Years With Budget' =
			COUNTROWS (
			    FILTER (
			        VALUES ( dim_period[year] ),
			        NOT ISBLANK ( CALCULATE ( [Budget Net Income] ) )
			    )
			)
		formatString: 0
		displayFolder: 03 Variance
		lineageTag: fe559e25-db31-4d9b-85d1-fb39689f9369

	/// Text version for the card visual, which compacts numbers to millions.
	measure 'Variance Card' = FORMAT ( [Net Income vs Budget], "+#,##0;-#,##0;0" )
		displayFolder: 03 Variance
		lineageTag: 1d0a4e5e-9392-4f2c-bb77-1b8aca5c9c86

	measure 'Variance % Card' = FORMAT ( [Net Income vs Budget %], "+0.0%;-0.0%;0.0%" )
		displayFolder: 03 Variance
		lineageTag: 3a58cb02-149a-4949-b9c4-301bee553b0c

	measure 'Years Ahead Card' = FORMAT ( [Years Ahead of Plan], "0" ) & " of " & FORMAT ( [Years With Budget], "0" )
		displayFolder: 03 Variance
		lineageTag: 5fe51661-5955-40a3-90b8-432efc2a6232

	measure 'Opex Variance Card' = FORMAT ( [Operating Expenses Variance], "+#,##0;-#,##0;0" )
		displayFolder: 03 Variance
		lineageTag: 37db9437-e81c-4723-a42f-87061ef334a7

	/// 2030 revenue in the committed base scenario, pre-tax basis of the P&L.
	measure 'Forecast Revenue' = CALCULATE ( [Scenario Revenue], dim_scenario[scenario_key] = "base" )
		formatString: #,##0
		displayFolder: 04 Forecast
		lineageTag: 2b429747-9ed1-4cd5-aa81-57cfb36f0d33

	measure 'Forecast Net Result' = CALCULATE ( [Scenario Net Result], dim_scenario[scenario_key] = "base" )
		formatString: #,##0
		displayFolder: 04 Forecast
		lineageTag: 9ffeb140-069f-4b91-a678-a5baf25af052

	measure 'Forecast Revenue Card' = FORMAT ( [Forecast Revenue], "#,##0" )
		displayFolder: 04 Forecast
		lineageTag: bf603499-71ea-455a-8087-fcdb2e5ae433

	measure 'Forecast Net Result Card' = FORMAT ( [Forecast Net Result], "#,##0" )
		displayFolder: 04 Forecast
		lineageTag: 09988d6b-74b6-4380-95e0-2f752c0d6b13

	/// The most recent fold that has actuals to compare against; F3 is the live
	/// forecast year and carries no MAPE.
	measure 'Backtest Fold Latest' =
			MAXX (
			    FILTER ( VALUES ( dim_fold[fold_key] ), NOT ISBLANK ( CALCULATE ( [MAPE Weighted] ) ) ),
			    dim_fold[fold_key]
			)
		displayFolder: 04 Forecast
		lineageTag: e8fcc3fe-dd91-4de6-bd88-95eefc39da56

	measure 'Backtest Accuracy Latest' =
			VAR LatestFold = [Backtest Fold Latest]
			RETURN
			    CALCULATE ( [Forecast Accuracy %], dim_fold[fold_key] = LatestFold )
		formatString: 0.0%
		displayFolder: 04 Forecast
		lineageTag: 2f4f251d-1191-426c-a85e-9b9822f225bd

	measure 'Backtest Bias Latest' =
			VAR LatestFold = [Backtest Fold Latest]
			RETURN
			    CALCULATE ( [Bias Weighted], dim_fold[fold_key] = LatestFold )
		formatString: +0.0%;-0.0%;0.0%
		displayFolder: 04 Forecast
		lineageTag: ccb95f7f-a973-4062-9598-cc5e83900815

	measure 'Backtest Accuracy Card' = FORMAT ( [Backtest Accuracy Latest], "0.0%" )
		displayFolder: 04 Forecast
		lineageTag: 492d6c9c-6ac6-44fe-8b85-8a7af0c6d8cd

	measure 'Backtest Bias Card' = FORMAT ( [Backtest Bias Latest], "+0.0%;-0.0%;0.0%" )
		displayFolder: 04 Forecast
		lineageTag: 974f8c9d-58ac-43be-ac50-be129a62308d

	measure 'Backtest Forecast Latest' =
			VAR LatestFold = [Backtest Fold Latest]
			RETURN
			    CALCULATE ( [Backtest Forecast], dim_fold[fold_key] = LatestFold )
		formatString: #,##0
		displayFolder: 04 Forecast
		lineageTag: aae346b5-62d4-4e8e-99d8-1d7c62d7b6a7

	measure 'Backtest Actual Latest' =
			VAR LatestFold = [Backtest Fold Latest]
			RETURN
			    CALCULATE ( [Backtest Actual], dim_fold[fold_key] = LatestFold )
		formatString: #,##0
		displayFolder: 04 Forecast
		lineageTag: 502c30c4-2d61-4d8d-addf-fb84392b902b

	/// Purchase intent, published for 2026-2028 only (L-15). Years without a
	/// published gap stay blank instead of pretending the market served it all.
	measure 'Demand Units' = IF ( ISBLANK ( [Unserved Units] ), BLANK (), [Market Units] + [Unserved Units] )
		formatString: #,##0
		displayFolder: 05 Market
		lineageTag: 10e0fbaa-12a1-4753-bd1f-6d1045316e9e

	measure 'Unserved Share %' = DIVIDE ( [Unserved Units], [Demand Units] )
		formatString: 0.0%
		displayFolder: 05 Market
		lineageTag: f81685c9-a75a-421a-b4dd-1b9c3b49b9aa

	/// Latest year that publishes a demand gap, so no year is hardcoded.
	measure 'Demand Year Latest' =
			MAXX (
			    FILTER ( VALUES ( dim_period[year] ), NOT ISBLANK ( CALCULATE ( [Unserved Units] ) ) ),
			    dim_period[year]
			)
		displayFolder: 05 Market
		lineageTag: 9be6a704-5aa3-44e2-ae51-9a21be62afaa

	measure 'Unserved Latest' =
			VAR LatestYear = [Demand Year Latest]
			RETURN
			    CALCULATE ( [Unserved Units], dim_period[year] = LatestYear )
		formatString: #,##0
		displayFolder: 05 Market
		lineageTag: 11fe7a85-10f3-43a0-a9ab-10f80d9eed1e

	measure 'Demand Latest' =
			VAR LatestYear = [Demand Year Latest]
			RETURN
			    CALCULATE ( [Demand Units], dim_period[year] = LatestYear )
		formatString: #,##0
		displayFolder: 05 Market
		lineageTag: 57e49e83-b8bc-4662-abb2-f8dccb43dd46

	measure 'Unserved Share Latest' =
			VAR LatestYear = [Demand Year Latest]
			RETURN
			    CALCULATE ( [Unserved Share %], dim_period[year] = LatestYear )
		formatString: 0.0%
		displayFolder: 05 Market
		lineageTag: d68c90d3-330b-4e60-8138-3d499ee062a9

	measure 'Company Units Latest' =
			VAR LatestYear = [Latest Closed Year]
			RETURN
			    CALCULATE ( [Market Units Sold], dim_period[year] = LatestYear )
		formatString: #,##0
		displayFolder: 05 Market
		lineageTag: 3098c6e5-4a85-4a30-9beb-e4f0a6d80bfe

	measure 'Unserved Card' = FORMAT ( [Unserved Latest], "#,##0" )
		displayFolder: 05 Market
		lineageTag: 685e8eed-a20a-4840-ba31-b23bdb425bd1

	measure 'Demand Card' = FORMAT ( [Demand Latest], "#,##0" )
		displayFolder: 05 Market
		lineageTag: ae108612-991d-4305-803d-5a25b144cb6b

	measure 'Unserved Share Card' = FORMAT ( [Unserved Share Latest], "0.0%" )
		displayFolder: 05 Market
		lineageTag: c26d8680-802b-4370-abbf-5c659a949279

	measure 'Company Units Card' = FORMAT ( [Company Units Latest], "#,##0" )
		displayFolder: 05 Market
		lineageTag: 7c3f0e2a-9b41-4c6d-8f2e-5a1b3c4d6e70

	/// Amounts are in euros and the model culture is es-PE, so charts that show a
	/// scale carry the suffix themselves instead of letting the locale print "mill.".
	measure 'Net Income M' = [Net Income] / 1000000
		formatString: #,##0.00"M"
		displayFolder: 01 Summary
		lineageTag: 9b5a2c3d-7e4f-4051-8b72-3c8d9e0f1a24

	measure 'Product Gross Margin M' = [Product Gross Margin] / 1000000
		formatString: #,##0.00"M"
		displayFolder: 02 Profitability
		lineageTag: ac6b3d4e-8f50-4162-9c83-4d9e0f1a2b35

	/// Demand is published in units and the model culture is es-PE, so the chart
	/// carries the K suffix itself instead of letting the locale pick "mil".
	measure 'Unserved Units K' = [Unserved Units] / 1000
		formatString: #,##0"K"
		displayFolder: 05 Market
		lineageTag: 8a4f1b2c-6d3e-4f50-9a61-2b7c8d9e0f13

	/// 2030 figure for whatever scenario the visual puts on its axis. Regime A only,
	/// so a scenario is not counted twice. The chart reads Scenario Revenue K.
	measure 'Scenario Revenue' = CALCULATE ( [Forecast Amount], dim_line_item[line_item_key] = "revenue_total" )
		formatString: #,##0
		displayFolder: 04 Forecast
		lineageTag: 4c1d7a90-6b2e-4f18-8d3a-0e5b7c9a1f21

	measure 'Scenario Net Result' = CALCULATE ( [Forecast Amount], dim_line_item[line_item_key] = "net_result_before_taxes" )
		formatString: #,##0
		displayFolder: 04 Forecast
		lineageTag: 5d2e8b01-7c3f-4a29-9e4b-1f6c8d0b2a32

	/// fact_backtest carries both regimes with identical values, so the sum is
	/// restricted to one of them; the ratio measures are unaffected because they
	/// divide one sum by another.
	measure 'Backtest Forecast' = CALCULATE ( SUM ( fact_backtest[forecast_amount] ), dim_regime[regime_key] = "A" )
		formatString: #,##0
		displayFolder: 04 Forecast
		lineageTag: 6e3f9c12-8d40-4b3a-af5c-2a7d9e1c3b43

	measure 'Backtest Actual' = CALCULATE ( SUM ( fact_backtest[actual_amount] ), dim_regime[regime_key] = "A" )
		formatString: #,##0
		displayFolder: 04 Forecast
		lineageTag: 7f40ad23-9e51-4c4b-b06d-3b8e0f2d4c54

	/// Forecast minus actual: negative means the model came in below reality.
	measure 'Backtest Error' = [Backtest Forecast] - [Backtest Actual]
		formatString: +#,##0;-#,##0;0
		displayFolder: 04 Forecast
		lineageTag: 8041be34-af62-4d5c-c17e-4c9f103e5d65

	measure 'Backtest Error Latest' = [Backtest Forecast Latest] - [Backtest Actual Latest]
		formatString: +#,##0;-#,##0;0
		displayFolder: 04 Forecast
		lineageTag: 9152cf45-b073-4e6d-d28f-5da0214f6e76

	/// The profit line alone, so a fold total is not a sum of subtotals.
	measure 'Backtest Net Forecast' = CALCULATE ( [Backtest Forecast], dim_line_item[line_item_key] = "net_result_before_taxes" )
		formatString: #,##0
		displayFolder: 04 Forecast
		lineageTag: a2638f56-c184-4f7e-e390-6eb1325a7f87

	measure 'Backtest Net Actual' = CALCULATE ( [Backtest Actual], dim_line_item[line_item_key] = "net_result_before_taxes" )
		formatString: #,##0
		displayFolder: 04 Forecast
		lineageTag: b3749a67-d295-4a8f-f4a1-7fc2436b8098

	measure 'Backtest Net Error' = [Backtest Net Forecast] - [Backtest Net Actual]
		formatString: +#,##0;-#,##0;0
		displayFolder: 04 Forecast
		lineageTag: c485ab78-e3a6-4b90-05b2-80d3547c91a9

	/// Blank for every line that is not a headline, so a bar chart of the miss
	/// shows five bars instead of twenty and never mixes a subtotal with its own
	/// components. The variable is not called Key: that name collides with the
	/// DAX KEY function and the measure fails to parse.
	measure 'Backtest Error Key Lines' =
			VAR LineKey = SELECTEDVALUE ( dim_line_item[line_item_key] )
			RETURN
			    IF (
			        LineKey = "revenue_total"
			            || LineKey = "cost_of_sales_total"
			            || LineKey = "gross_profit"
			            || LineKey = "operating_expenses_total"
			            || LineKey = "net_result_before_taxes",
			        [Backtest Error Latest]
			    )
		formatString: +#,##0;-#,##0;0
		displayFolder: 04 Forecast
		lineageTag: d596bc89-f4b7-4ca1-16c3-91e4658da2ba

	/// Chart-only twins in thousands. Auto display units take their suffix from
	/// the model culture (es-PE) and render "mil" inside an English report, so the
	/// K suffix is a literal in the format string instead.
	measure 'Scenario Revenue K' = [Scenario Revenue] / 1000
		formatString: #,##0"K"
		displayFolder: 04 Forecast
		lineageTag: e1a7cd90-a5c8-4d32-9b74-60f5961af3cb

	measure 'Scenario Net Result K' = [Scenario Net Result] / 1000
		formatString: #,##0"K"
		displayFolder: 04 Forecast
		lineageTag: f2b8de01-b6d9-4e43-ac85-71a6a72b04dc

	measure 'Backtest Error K' = DIVIDE ( [Backtest Error Key Lines], 1000 )
		formatString: +#,##0"K";-#,##0"K";0"K"
		displayFolder: 04 Forecast
		lineageTag: 03c9ef12-c7ea-4f54-bd96-82b7b83c15ed

	/// Page-03 chart twins in thousands; see the note on Scenario Revenue K for
	/// why the K is a literal instead of a display unit. Values that round to zero
	/// collapse to zero so the label never prints "-0K".
	measure 'Bridge Total K' =
			VAR Thousands = [Bridge Total] / 1000
			RETURN
			    IF ( ABS ( Thousands ) < 0.5, 0, Thousands )
		formatString: +#,##0"K";-#,##0"K";0"K"
		displayFolder: 03 Variance
		lineageTag: 14da0f23-d8fb-4a65-ce07-93c8c94d26fe

	measure 'Operating Expenses Variance K' = [Operating Expenses Variance] / 1000
		formatString: +#,##0"K";-#,##0"K";0"K"
		displayFolder: 03 Variance
		lineageTag: 25eb1034-e90c-4b76-df18-a4d9da5e37af

	/// Safe above year grain: [Market Units] covers all six years but demand is
	/// published for three, so folding both across years would divide three years
	/// of unserved demand by six years of market. This restricts the base to the
	/// years that carry demand.
	measure 'Unserved Share Published %' =
			VAR Unserved = [Unserved Units]
			VAR PublishedMarket =
			    SUMX (
			        FILTER ( VALUES ( dim_period[year] ), NOT ISBLANK ( [Unserved Units] ) ),
			        [Market Units]
			    )
			RETURN
			    DIVIDE ( Unserved, PublishedMarket + Unserved )
		formatString: 0.0%
		displayFolder: 05 Market
		lineageTag: 4a1b558d-af44-4e42-ae6f-5b7d60028f29

	column Dummy
		dataType: string
		isHidden
		lineageTag: aa3dcf9f-3b66-4bfb-87f0-4b80acd49c0c
		summarizeBy: none
		sourceColumn: [Dummy]

	partition _Measures = calculated
		mode: import
		source = ROW("Dummy", BLANK())

