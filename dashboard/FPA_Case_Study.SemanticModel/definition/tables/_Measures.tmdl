table _Measures

	/// Revenue recognised in the selected period, always from the actual scenario.
	measure Revenue =
			CALCULATE(
			    SUM(fact_financials[amount]),
			    dim_scenario[scenario_key] = "actual",
			    dim_line_item[line_item_key] = "revenue_total"
			)
		formatString: #,##0
		displayFolder: 01 Executive

	/// Revenue less cost of sales.
	measure 'Gross Margin' =
			CALCULATE(
			    SUM(fact_financials[amount]),
			    dim_scenario[scenario_key] = "actual",
			    dim_line_item[line_item_key] = "gross_profit"
			)
		formatString: #,##0
		displayFolder: 01 Executive

	measure 'Gross Margin %' =
			DIVIDE([Gross Margin], [Revenue])
		formatString: 0.0%
		displayFolder: 01 Executive

	/// Result before tax. The budget carries no tax line, so every variance is measured pre-tax.
	measure 'Net Income' =
			CALCULATE(
			    SUM(fact_financials[amount]),
			    dim_scenario[scenario_key] = "actual",
			    dim_line_item[line_item_key] = "net_result_before_taxes"
			)
		formatString: #,##0
		displayFolder: 01 Executive

	measure 'Net Margin %' =
			DIVIDE([Net Income], [Revenue])
		formatString: 0.0%
		displayFolder: 01 Executive

	/// Latest year with a reported close. Use it in titles instead of hardcoding a year.
	measure 'Latest Closed Year' =
			CALCULATE(
			    MAX(dim_period[year]),
			    dim_period[grain] = "year",
			    dim_period[is_closed] = TRUE()
			)
		formatString: 0
		displayFolder: 01 Executive

	/// Cash at the end of the period. Balances are semi-additive: never sum across time.
	measure 'Closing Cash' =
			CALCULATE(
			    SUM(fact_balance[amount]),
			    dim_account[account_key] = "cash",
			    LASTNONBLANK(dim_period[year], 1)
			)
		formatString: #,##0
		displayFolder: 01 Executive

	measure 'Total Assets' =
			CALCULATE(
			    SUM(fact_balance[amount]),
			    dim_account[account_key] = "total_assets",
			    LASTNONBLANK(dim_period[year], 1)
			)
		formatString: #,##0
		displayFolder: 01 Executive

	measure 'Product Revenue' =
			SUM(fact_product_annual[revenue])
		formatString: #,##0
		displayFolder: 02 Profitability

	measure 'Product Gross Margin' =
			SUM(fact_product_annual[gross_margin])
		formatString: #,##0
		displayFolder: 02 Profitability

	measure 'Product Margin %' =
			DIVIDE([Product Gross Margin], [Product Revenue])
		formatString: 0.0%
		displayFolder: 02 Profitability

	measure 'Units Sold' =
			SUM(fact_sales[units_sold])
		formatString: #,##0
		displayFolder: 02 Profitability

	measure 'Quarterly Revenue' =
			SUM(fact_sales[revenue])
		formatString: #,##0
		displayFolder: 02 Profitability

	measure 'Budget Net Income' =
			CALCULATE(
			    SUM(fact_financials[amount]),
			    dim_scenario[scenario_key] = "budget",
			    dim_line_item[line_item_key] = "net_result_before_taxes"
			)
		formatString: #,##0
		displayFolder: 03 Variance

	measure 'Net Income vs Budget' =
			[Net Income] - [Budget Net Income]
		formatString: #,##0
		displayFolder: 03 Variance

	measure 'Net Income vs Budget %' =
			DIVIDE([Net Income vs Budget], [Budget Net Income])
		formatString: 0.0%
		displayFolder: 03 Variance

	/// Sum of the bridge drivers. Must equal [Net Income vs Budget] to the euro.
	measure 'Bridge Total' =
			SUM(fact_variance[amount])
		formatString: #,##0
		displayFolder: 03 Variance

	measure 'Bridge Residual' =
			[Bridge Total] - [Net Income vs Budget]
		formatString: #,##0
		displayFolder: 03 Variance

	measure 'Forecast Amount' =
			SUM(fact_forecast[forecast_amount])
		formatString: #,##0
		displayFolder: 04 Forecast

	measure 'Forecast Error' =
			SUM(fact_backtest[error_eur])
		formatString: #,##0
		displayFolder: 04 Forecast

	/// Weighted error: ratio of sums, never an average of per-line percentages.
	measure 'MAPE Weighted' =
			DIVIDE(
			    SUMX(fact_backtest, ABS(fact_backtest[error_eur])),
			    SUMX(fact_backtest, ABS(fact_backtest[actual_amount]))
			)
		formatString: 0.0%
		displayFolder: 04 Forecast

	/// Positive means the forecast landed above the actual outcome.
	measure 'Bias Weighted' =
			DIVIDE(
			    SUM(fact_backtest[error_eur]),
			    SUMX(fact_backtest, ABS(fact_backtest[actual_amount]))
			)
		formatString: +0.0%;-0.0%;0.0%
		displayFolder: 04 Forecast

	measure 'Forecast Accuracy %' =
			1 - [MAPE Weighted]
		formatString: 0.0%
		displayFolder: 04 Forecast

	measure 'Market Units' =
			SUM(fact_market[market_units])
		formatString: #,##0
		displayFolder: 05 Market

	measure 'Market Units Sold' =
			SUM(fact_market[units_sold])
		formatString: #,##0
		displayFolder: 05 Market

	measure 'Market Share %' =
			DIVIDE([Market Units Sold], [Market Units])
		formatString: 0.0%
		displayFolder: 05 Market

	measure 'Unserved Units' =
			SUM(fact_market[unserved_units])
		formatString: #,##0
		displayFolder: 05 Market

	column Dummy
		dataType: string
		isHidden
		summarizeBy: none
		sourceColumn: [Dummy]

	partition _Measures = calculated
		mode: import
		source = ROW("Dummy", BLANK())
