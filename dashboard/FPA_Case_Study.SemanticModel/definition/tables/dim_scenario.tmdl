table dim_scenario
	lineageTag: 1e3930f5-1e0a-48ab-bda2-b3ccb0178236

	column scenario_key
		dataType: string
		isHidden
		lineageTag: 729db106-144d-48b6-a894-0413d52a164f
		summarizeBy: none
		sourceColumn: scenario_key

	column label
		dataType: string
		lineageTag: f6b94f92-a8a5-4123-973b-735a9997ea9a
		summarizeBy: none
		sourceColumn: label
		sortByColumn: sort_order

	column is_committed
		dataType: boolean
		lineageTag: d5ad45f2-fa71-4555-b817-03510375832f
		summarizeBy: none
		sourceColumn: is_committed

	column sort_order
		dataType: int64
		isHidden
