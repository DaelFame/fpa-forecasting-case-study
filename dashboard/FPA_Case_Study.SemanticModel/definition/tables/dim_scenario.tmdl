table dim_scenario

	column scenario_key
		dataType: string
		isHidden
		summarizeBy: none
		sourceColumn: scenario_key

	column label
		dataType: string
		sortByColumn: sort_order
		summarizeBy: none
		sourceColumn: label

	column is_committed
		dataType: boolean
		summarizeBy: none
		sourceColumn: is_committed

	column sort_order
		dataType: int64
		isHidden
		summarizeBy: none
		sourceColumn: sort_order

	partition dim_scenario = m
		mode: import
		source =
			let
				Origen = Csv.Document(File.Contents(pDataFolder & "\dim_scenario.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				Encabezados = Table.PromoteHeaders(Origen, [PromoteAllScalars=true]),
				Tipos = Table.TransformColumnTypes(Encabezados, {{"scenario_key", type text}, {"label", type text}, {"is_committed", type logical}, {"sort_order", Int64.Type}})
			in
				Tipos
