{
  "name": "FPA Case Study",
  "dataColors": [
    "#1F3864",
    "#2E75B6",
    "#5B9BD5",
    "#A9C7E8",
    "#C00000",
    "#E8A33D",
    "#4E7A4E",
    "#8C8C8C"
  ],
  "background": "#FFFFFF",
  "foreground": "#1A1A1A",
  "tableAccent": "#1F3864",
  "good": "#4E7A4E",
  "neutral": "#8C8C8C",
  "bad": "#C00000",
  "textClasses": {
    "callout": {
      "fontSize": 32,
      "fontFace": "Segoe UI Semibold",
      "color": "#1F3864"
    },
    "title": {
      "fontSize": 16,
      "fontFace": "Segoe UI Semibold",
      "color": "#1F3864"
    },
    "header": {
      "fontSize": 11,
      "fontFace": "Segoe UI Semibold",
      "color": "#595959"
    },
    "label": {
      "fontSize": 10,
      "fontFace": "Segoe UI",
      "color": "#3C3C3C"
    }
  },
  "visualStyles": {
    "*": {
      "*": {
        "background": [
          {
            "show": true,
            "color": { "solid": { "color": "#FFFFFF" } },
            "transparency": 0
          }
        ],
        "border": [
          {
            "show": true,
            "color": { "solid": { "color": "#E6E9EF" } },
            "radius": 8
          }
        ],
        "dropShadow": [
          {
            "show": false,
            "color": { "solid": { "color": "#000000" } },
            "position": "Outer",
            "preset": "BottomRight",
            "transparency": 100
          }
        ],
        "visualHeader": [
          {
            "show": true,
            "background": { "solid": { "color": "#FFFFFF" } },
            "foreground": { "solid": { "color": "#8C8C8C" } },
            "transparency": 0
          }
        ]
      }
    },
    "page": {
      "*": {
        "background": [
          {
            "color": { "solid": { "color": "#F5F7FA" } },
            "transparency": 0
          }
        ],
        "outspace": [
          {
            "color": { "solid": { "color": "#F5F7FA" } },
            "transparency": 0
          }
        ]
      }
    },
    "card": {
      "*": {
        "labels": [
          {
            "color": { "solid": { "color": "#595959" } },
            "fontSize": 10
          }
        ],
        "categoryLabels": [
          {
            "show": false
          }
        ]
      }
    }
  }
}
